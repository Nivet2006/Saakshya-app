# =====================================================
# Sakshya ASHA Mobile (Expo / React Native) Configuration
# Copy to .env for local / LAN mobile development.
# NEVER commit .env or bundle private API keys!
# =====================================================

# Agent 1 FastAPI Voice Backend Endpoints (Gnani Prisma v3.0 STT + Timbre v3.0 TTS + Gemini)
# For physical Android/iOS device on same Wi-Fi, use your machine's LAN IP (e.g. http://10.178.123.170:8000)
# You can also override the Backend URL directly inside the app's Connection Settings drawer!
EXPO_PUBLIC_VOICE_API_BASE_URL=http://10.178.123.170:8000
EXPO_PUBLIC_VOICE_WS_URL=ws://10.178.123.170:8000

# Optional Supabase Public Client (Safe for mobile — Anon Key only; NEVER put SUPABASE_SERVICE_ROLE_KEY here)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# Default Language & Synthetic Data Policy
EXPO_PUBLIC_DEFAULT_LANGUAGE=hi-IN
EXPO_PUBLIC_SUPPORTED_LANGUAGES=hi-IN,kn-IN,ta-IN,te-IN,ml-IN,bn-IN,mr-IN,gu-IN,pa-IN,en-IN
EXPO_PUBLIC_SYNTHETIC_DATA_ONLY=true
