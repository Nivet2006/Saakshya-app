{
  "expo": {
    "name": "Saakshya ASHA",
    "slug": "sakshya-asha-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#0F766E"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.nhm.sakshya.asha",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Saakshya ASHA needs microphone access to capture your household visit voice notes in Indic languages via Gnani Prisma STT.",
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "org.nhm.sakshya.asha",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.VIBRATE"
      ]
    },
    "plugins": [
      "./plugins/withCleartextTraffic",
      [
        "expo-av",
        {
          "microphonePermission": "Saakshya ASHA needs microphone access to capture your household visit voice notes in Indic languages."
        }
      ]
    ]
  }
}

